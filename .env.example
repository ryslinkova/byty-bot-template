# Gmail SMTP credentials for sending the daily report.
# Generate an App Password: Google Account -> Security -> 2-Step Verification -> App passwords.
# (A normal account password will NOT work with SMTP.)
GMAIL_USER=tvuj.ucet@gmail.com
GMAIL_APP_PASSWORD=

# Where the daily report is sent. Multiple recipients: comma-separated.
# If empty, falls back to RECIPIENT_EMAILS in config.py (empty by default).
REPORT_RECIPIENT=prijemce@example.com
